datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String    @unique
  email     String?
  address   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]

  @@map("invoice_customers")
}

model Service {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  rate      Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoice_services")
}

model Invoice {
  id                 Int           @id @default(autoincrement())
  invoiceNumber      String        @unique
  date               DateTime      @default(now())
  customerId         Int?
  customer           Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName       String
  customerPhone      String
  customerEmail      String?
  customerAddress    String
  items              InvoiceItem[]
  totalAmount        Float         @default(0)
  totalPayableAmount Float         @default(0)
  paidAmount         Float         @default(0)
  dueAmount          Float         @default(0)
  paymentStatus      String        @default("Due")
  amountInWords      String
  templateName       String        @default("template1")
  accountName        String?       @default("RAJSEBA.COM")
  accountNumber      String?       @default("02433002451")
  bankName           String?       @default("Bank Asia PLC")
  branch             String?       @default("Rajshahi Branch")
  routingNumber      String?       @default("070811937")
  signeeName         String?       @default("Ariful Islam Arif")
  signeeRole         String?       @default("CEO, Rajseba Design Studio")
  status             String        @default("active")
  deletedAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@map("invoices")
}

model InvoiceItem {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  qty         Float    @default(1)
  rate        Float    @default(0)
  amount      Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("invoice_items")
}
