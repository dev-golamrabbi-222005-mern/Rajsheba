{
  "name": "rajsheba-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:invoices-web": "npm run dev --workspace=apps/invoices-web",
    "dev:invoices-api": "npm run dev --workspace=apps/invoices-api",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "build:invoices-web": "npm run build --workspace=apps/invoices-web",
    "build:all": "npm run build --workspaces"
  }
}
